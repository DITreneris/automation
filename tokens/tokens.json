{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "bg": {
      "$type": "color",
      "$value": "#F7F8FA",
      "$description": "Page background"
    },
    "bgSubtle": {
      "$type": "color",
      "$value": "#F0F4F8",
      "$description": "Subtle surface, hover backgrounds"
    },
    "white": {
      "$type": "color",
      "$value": "#FFFFFF"
    },
    "text": {
      "$type": "color",
      "$value": "#1A202C",
      "$description": "Primary text"
    },
    "textLight": {
      "$type": "color",
      "$value": "#4A5568",
      "$description": "Secondary text"
    },
    "border": {
      "$type": "color",
      "$value": "#CBD5E0"
    },
    "accent": {
      "gold": {
        "$type": "color",
        "$value": "#CFA73A",
        "$description": "Progress, badge, focus ring"
      },
      "goldHover": {
        "$type": "color",
        "$value": "#E8B93C"
      },
      "goldDark": {
        "$type": "color",
        "$value": "#B8932E"
      },
      "dark": {
        "$type": "color",
        "$value": "#0B1320",
        "$description": "Hero, primary CTA, headings"
      },
      "darkHover": {
        "$type": "color",
        "$value": "#16202F"
      }
    },
    "brand": {
      "teal": {
        "$type": "color",
        "$value": "#008579",
        "$description": "Library mark, links, nav chips, community CTA"
      },
      "tealHover": {
        "$type": "color",
        "$value": "#006960"
      },
      "tealDark": {
        "$type": "color",
        "$value": "#0a5c54"
      }
    },
    "feedback": {
      "green": {
        "$type": "color",
        "$value": "#38A169"
      },
      "greenHover": {
        "$type": "color",
        "$value": "#2F855A"
      },
      "error": {
        "$type": "color",
        "$value": "#E53E3E"
      }
    },
    "palette": {
      "blueLight": {
        "$type": "color",
        "$value": "#E8ECF0"
      },
      "orange": {
        "$type": "color",
        "$value": "#B8932E"
      },
      "orangeLight": {
        "$type": "color",
        "$value": "#FBF6EB"
      },
      "purple": {
        "$type": "color",
        "$value": "#6B5B95"
      },
      "tertiaryLight": {
        "$type": "color",
        "$value": "#CCFBF1"
      }
    }
  },
  "dimension": {
    "radius": {
      "sm": { "$type": "dimension", "$value": "6px" },
      "md": { "$type": "dimension", "$value": "12px" },
      "lg": { "$type": "dimension", "$value": "16px" },
      "xl": { "$type": "dimension", "$value": "20px" }
    },
    "space": {
      "0": { "$type": "dimension", "$value": "4px" },
      "1": { "$type": "dimension", "$value": "8px" },
      "1_5": { "$type": "dimension", "$value": "12px" },
      "2": { "$type": "dimension", "$value": "16px" },
      "3": { "$type": "dimension", "$value": "20px" },
      "4": { "$type": "dimension", "$value": "24px" },
      "5": { "$type": "dimension", "$value": "28px" },
      "6": { "$type": "dimension", "$value": "36px" },
      "7": { "$type": "dimension", "$value": "40px" },
      "8": { "$type": "dimension", "$value": "48px" }
    }
  },
  "font": {
    "size": {
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "meta": { "$type": "dimension", "$value": "0.9375rem" },
      "bodySm": { "$type": "dimension", "$value": "1rem" },
      "body": { "$type": "dimension", "$value": "1.125rem" },
      "button": { "$type": "dimension", "$value": "1.0625rem" },
      "lead": { "$type": "dimension", "$value": "1.25rem" },
      "h2": { "$type": "dimension", "$value": "1.375rem" },
      "h2Lg": { "$type": "dimension", "$value": "1.5rem" },
      "hero": {
        "$type": "dimension",
        "$value": "3.25rem",
        "$description": "Max of clamp(1.75rem, 2vw + 1.5rem, 3.25rem) in tokens.css"
      }
    }
  }
}
